FROM python:3.12-slim-bookworm
RUN groupadd --gid 10001 proxy && useradd --uid 10001 --gid 10001 --no-create-home proxy
WORKDIR /opt/proxy
COPY __init__.py policy.py proxy.py ./browser_worker/
USER 10001:10001
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
CMD ["python", "-m", "browser_worker.proxy"]
