BOT_TOKEN=
ALLOWED_TELEGRAM_USER_ID=

# Primary LLM: Groq (100% Free, 14,400 requests/day, lightning-fast Llama 3.3 70B)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=llama-3.2-11b-vision-preview

# Optional Fallbacks: OpenRouter / Gemini
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

TIMEZONE=Asia/Kolkata
DB_PATH=

# Web Server Port (Render sets this automatically)
PORT=10000

# Turso Cloud SQLite (for 24/7 permanent storage without a card)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
