BOT_TOKEN=
ALLOWED_TELEGRAM_USER_ID=

# Primary LLM: Gemini (High performance and native multimodal capabilities)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional Fallbacks: Groq / OpenRouter
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=llama-3.2-11b-vision-preview
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

TIMEZONE=Asia/Kolkata
DB_PATH=data/alisa.db

# Web Server Port (Render sets this automatically)
PORT=10000

# Required shared secret for desktop API routes; blank leaves those routes disabled (503)
WEB_AUTH_TOKEN=

# Turso Cloud SQLite (for 24/7 permanent storage without a card)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# High-Definition Photorealistic Image Generation Engines
TOGETHER_API_KEY=
HF_TOKEN=

# Optional GitHub API Token for repo commit lookups
GITHUB_TOKEN=

# Quiet Hours (Bot will not proactively ping during these hours, local time)
QUIET_START_HOUR=23
QUIET_END_HOUR=7

SLEEP_START_HOUR=3
SLEEP_END_HOUR=6
THOUGHT_INTERVAL_MINUTES=12
CONSCIOUSNESS_TICK_MINUTES=5


# Sidecar endpoint: configure explicitly, HTTPS is required; no built-in destination.
SOFIA_BASE_URL=

# Desktop permissions must be set on BOTH server and sidecar as needed.
# All sensitive capabilities default off. Raw shell is never supported.
DESKTOP_ALLOW_SCREEN_CAPTURE=false
DESKTOP_ALLOW_CLIPBOARD_READ=false
DESKTOP_ALLOW_CLIPBOARD_WRITE=false
DESKTOP_ALLOW_MUTATIONS=false
DESKTOP_WORKSPACE_ROOT=
DESKTOP_PAUSED=false
# Optional local kill switch: any file at this path pauses desktop access.
DESKTOP_PAUSE_FILE=
# Optional local overlay secret; otherwise sidecar derives a scoped stable token.
# Never use WEB_AUTH_TOKEN as the overlay token.
SOFIA_OVERLAY_TOKEN=

# Optional one-specialist review; direct generation is the default.
ENABLE_SPECIALISTS=false

# Dynamic priorities: ship disabled; see docs/dynamic-priority-tracker.md
ENABLE_OUTCOMES=false
ENABLE_OUTCOME_CHECKPOINTS=false

# Background research: disabled until an approved supervised rollout.
# No new search-provider credentials needed; existing DDGS + configured LLM.
ENABLE_RESEARCH_JOBS=false
# Optional separate signed-out browser worker; see docs/browser-worker.md.
# Do not point at a public CDP port or reuse desktop/Telegram/database tokens.
ENABLE_RESEARCH_BROWSER=false
BROWSER_WORKER_URL=
BROWSER_WORKER_TOKEN=

# Research limits can be lowered; hard ceilings remain in application code.
RESEARCH_MAX_ACTIVE=3
RESEARCH_MAX_DAILY=10
RESEARCH_MAX_QUERIES=6
RESEARCH_MAX_PAGES=6
RESEARCH_MAX_BROWSER_RENDERS=2
RESEARCH_MAX_MODEL_CALLS=8
RESEARCH_MAX_SECONDS=120
RESEARCH_MAX_INPUT_TOKENS=60000
RESEARCH_MAX_OUTPUT_TOKENS=10000
