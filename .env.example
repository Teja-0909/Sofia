BOT_TOKEN=
ALLOWED_TELEGRAM_USER_ID=

# Primary LLM: Gemini (High performance and native multimodal capabilities)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional Fallbacks: Groq / OpenRouter
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=llama-3.2-11b-vision-preview
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

TIMEZONE=Asia/Kolkata
DB_PATH=data/alisa.db

# Web Server Port (Render sets this automatically)
PORT=10000

# Shared Secret for Web Endpoints Auth (if not set, do not expose port to public network)
WEB_AUTH_TOKEN=

# Turso Cloud SQLite (for 24/7 permanent storage without a card)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# High-Definition Photorealistic Image Generation Engines
TOGETHER_API_KEY=
HF_TOKEN=

# Optional GitHub API Token for repo commit lookups
GITHUB_TOKEN=

# Quiet Hours (Bot will not proactively ping during these hours, local time)
QUIET_START_HOUR=23
QUIET_END_HOUR=7

SLEEP_START_HOUR=3
SLEEP_END_HOUR=6
THOUGHT_INTERVAL_MINUTES=12
CONSCIOUSNESS_TICK_MINUTES=5
